{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown event type returns ok",
      "method": "POST",
      "path": "/",
      "body": {
        "type": "unknown_event"
