      "expectedStatus": 200,
      "expectedBody": "ok",
      "bodyMatcher": "partial"
    },
    {
      "name": "Message from unknown VK user",
      "method": "POST",
      "path": "/",
      "body": {
        "type": "message_new",
        "object": {
          "message": {
            "from_id": -5,
            "text": "меню"
          }
        }
      },
      "expectedStatus": 200,
      "expectedBody": "ok",
      "bodyMatcher": "partial"
    }
  ]
}