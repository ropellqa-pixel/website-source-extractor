{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Select disallowed table",
      "method": "POST",
      "path": "/",
      "body": {"table": "not_a_real_table", "op": "select"},
      "expectedStatus": 200,
      "expectedBody": {"data": null},
      "bodyMatcher": "partial"
    },
    {
      "name": "Select companies",
      "method": "POST",
      "path": "/",
      "body": {"table": "companies", "op": "select", "filters": [{"col": "id", "op": "eq", "value": "main"}], "single_mode": "maybe"},
      "expectedStatus": 200,
      "expectedBody": {"error": null},
      "bodyMatcher": "partial"
    },
    {
      "name": "Insert test document",
      "method": "POST",
      "path": "/",
      "body": {"table": "documents", "op": "insert", "payload": {"id": "test-doc-tests-json", "title": "Test", "content": "x", "author": "test"}},
      "expectedStatus": 200,
      "expectedBody": {"error": null},
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete test document",
      "method": "POST",
      "path": "/",
      "body": {"table": "documents", "op": "delete", "filters": [{"col": "id", "op": "eq", "value": "test-doc-tests-json"}]},
      "expectedStatus": 200,
      "expectedBody": {"error": null},
      "bodyMatcher": "partial"
    }
  ]
}