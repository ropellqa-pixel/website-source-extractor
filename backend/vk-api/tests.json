{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Status without login rejected",
      "method": "GET",
      "path": "/?action=status&profile_id=x",
      "expectedStatus": 401
    },
    {
      "name": "Generate code without login rejected",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "generate_code",
        "profile_id": "x"
      },
      "expectedStatus": 401
    },
    {
      "name": "Broadcast without login rejected",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "broadcast",
        "items": [
          {
            "a": 1
          }
        ]
      },
      "expectedStatus": 401
    }
  ]
}