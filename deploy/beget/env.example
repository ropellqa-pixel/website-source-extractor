# === АнодБИЗ: настройки сервера на Beget ===
# Скопируйте этот файл в .env (cp env.example .env) и заполните значения.
# Файл .env никому не показывайте и не публикуйте.

# База PostgreSQL (Beget → Базы данных → PostgreSQL → данные подключения)
DATABASE_URL=postgresql://ЛОГИН:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ
MAIN_DB_SCHEMA=public

# Хранилище S3 Beget (Beget → Облако → S3 → ваш бакет → ключи доступа)
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_REGION=ru1
S3_BUCKET=ИМЯ_БАКЕТА
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://s3.ru1.storage.beget.cloud/ИМЯ_БАКЕТА

# Ключ шифрования данных банка (придумайте длинную случайную строку и не меняйте её)
SBER_VAULT_KEY=

# СберБизнес
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
SBER_CERT_PASSWORD=
SBER_REDIRECT_URI=https://bizwor.ru/api/sber-api

# ВКонтакте (бот-рассыльщик)
VK_GROUP_ID=
VK_GROUP_TOKEN=
VK_CALLBACK_CONFIRMATION=

# Максимальное время одного запроса, мс
ANOD_TIMEOUT_MS=30000
