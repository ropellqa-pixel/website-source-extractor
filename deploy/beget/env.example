# === АнодБИЗ 36.20: настройки сервера api.bizwor.ru ===
# Файл .env никому не показывайте и не публикуйте.

# База PostgreSQL 16.4 (Beget → Облако → Базы данных). Пароль вставьте вместо ПАРОЛЬ.
# Если в пароле есть символы @ : / ? # % — сообщите Юре, их нужно закодировать.
DATABASE_URL=postgresql://cloud_user:ПАРОЛЬ@nerepojeestdim.beget.app:5432/default_db?sslmode=prefer
MAIN_DB_SCHEMA=public

# Хранилище S3 Beget
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_REGION=ru1
S3_BUCKET=6bcae0de293d-bizwor
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://s3.ru1.storage.beget.cloud/6bcae0de293d-bizwor

# Ключ шифрования данных банка. Придумайте длинную строку (от 32 символов) и НИКОГДА не меняйте.
SBER_VAULT_KEY=

# Ключ для разового переноса базы со старого сервера (выдал Юра)
MIGRATE_KEY=

# СберБизнес
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
SBER_CERT_PASSWORD=
SBER_REDIRECT_URI=https://api.bizwor.ru/sber-api

# ВКонтакте (бот-рассыльщик)
VK_GROUP_ID=
VK_GROUP_TOKEN=
VK_CALLBACK_CONFIRMATION=

ANOD_TIMEOUT_MS=30000
