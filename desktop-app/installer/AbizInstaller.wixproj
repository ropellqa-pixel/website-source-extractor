<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>AbizSetup</OutputName>
    <OutputType>Package</OutputType>
    <!--
      Папка с опубликованной программой. Сначала надо выполнить:
        dotnet publish ..\AbizShell\AbizShell.csproj -c Release -r win-x64 --self-contained false
      и только потом собирать этот проект.
    -->
    <PublishDir>$(MSBuildThisFileDirectory)..\AbizShell\bin\Release\net8.0-windows\win-x64\publish</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Расширение WixToolset.UI даёт готовый интерфейс установщика с шагами и лицензией. -->
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
