<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>AbizSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <PublishDir>$(MSBuildThisFileDirectory)..\AbizShell\bin\Release\net8.0-windows\win-x64\publish</PublishDir>
    <!-- Путь к MSI, собранному проектом AbizInstaller.wixproj (собирать его первым). -->
    <MsiPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\AbizSetup.msi</MsiPath>
    <DefineConstants>PublishDir=$(PublishDir);MsiPath=$(MsiPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.NetFx.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
