<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>AbizSetup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ru-RU</Cultures>
    <OutputPath>$(MSBuildThisFileDirectory)..\out\</OutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\AbizShell\bin\publish</PublishDir>
    <RecorderDir>$(MSBuildThisFileDirectory)..\..\AbizRecorder\bin\publish</RecorderDir>
    <DefineConstants>PublishDir=$(PublishDir);RecorderDir=$(RecorderDir)</DefineConstants>
    <!-- Проверки ярлыков для установки "для всех пользователей" дают ложные ошибки. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>