<?xml version="1.0" encoding="UTF-8"?>
<!-- MSI-пакет АБИЗ. Сборка: dotnet build installer\msi\AbizInstaller.wixproj -c Release -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="АБИЗ" Manufacturer="ООО «Рассвет»" Version="1.3.0.0"
           UpgradeCode="8a2e1c6a-5b3e-4d2a-9c7a-1f6e3b2d4a10"
           InstallerVersion="500" Compressed="yes" Scope="perMachine"
           Language="1049" Codepage="1251">

    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия АБИЗ." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="AbizIcon" />

    <Feature Id="MainFeature" Title="АБИЗ Shell" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="RecorderFiles" />
      <ComponentRef Id="TaskFile" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AnodBiz">
        <Directory Id="APPDIR" Name="AbizShell">
          <Directory Id="RECORDERDIR" Name="Recorder" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="АБИЗ" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="APPDIR">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- Служба «AbizRecorder» — видеорегистратор склада, работает всегда (даже до входа в АБИЗ). -->
    <ComponentGroup Id="RecorderFiles" Directory="RECORDERDIR">
      <Files Include="$(var.RecorderDir)\**" />
    </ComponentGroup>

    <!-- Описание задачи Планировщика (автозапуск с правами администратора при входе). -->
    <Component Id="TaskFile" Directory="APPDIR" Guid="3b7d2f4e-8a1c-4e6b-9f2d-5c8a1e7b3d60">
      <File Id="TaskXml" Source="AbizShell-task.xml" Name="AbizShell-task.xml" KeyPath="yes" />
    </Component>

    <!--
      Ярлыки. Раньше сборка падала, потому что у ярлыка, который ставится всем
      пользователям, не было ключа в реестре (ошибки проверки ICE38/ICE43/ICE57). Теперь у каждого
      ярлыка свой ключ в реестре, а эти проверки отключены в AbizInstaller.wixproj.
    -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="7c1e5a3d-2b9f-4d8e-a6c4-1f3b9e7d5a21">
      <Shortcut Id="AbizDesktopShortcut" Name="АБИЗ" Description="Рабочая оболочка АБИЗ"
                Target="[APPDIR]AbizShell.exe" WorkingDirectory="APPDIR" Icon="AbizIcon" />
      <RegistryValue Root="HKCU" Key="Software\AnodBiz\AbizShell" Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="StartMenuDir" Guid="9e4b2c7a-5d1f-4a3e-8b6c-2d7f1a9e4c83">
      <Shortcut Id="AbizStartShortcut" Name="АБИЗ" Description="Рабочая оболочка АБИЗ"
                Target="[APPDIR]AbizShell.exe" WorkingDirectory="APPDIR" Icon="AbizIcon" />
      <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\AnodBiz\AbizShell" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      Автозапуск: задача «AbizShell» в Планировщике заданий Windows, запуск при входе
      любого пользователя с обычными правами — никакого вопроса «Разрешить изменения?».
      Старую запись автозапуска из реестра удаляем, чтобы не было двойного запуска.
    -->
    <SetProperty Id="CreateAbizTask" Sequence="execute" Before="CreateAbizTask"
                 Value="&quot;[System64Folder]schtasks.exe&quot; /Create /F /TN &quot;AbizShell&quot; /XML &quot;[APPDIR]AbizShell-task.xml&quot;" />
    <CustomAction Id="CreateAbizTask" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="DeleteAbizTask" Sequence="execute" Before="DeleteAbizTask"
                 Value="&quot;[System64Folder]schtasks.exe&quot; /Delete /F /TN &quot;AbizShell&quot;" />
    <CustomAction Id="DeleteAbizTask" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="RemoveOldRunKeys" Sequence="execute" Before="RemoveOldRunKeys"
                 Value="&quot;[System64Folder]reg.exe&quot; delete &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run&quot; /v AbizShell /f" />
    <CustomAction Id="RemoveOldRunKeys" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!--
      Права на запись в папку программы для всех пользователей ПК — чтобы удалённое
      автообновление заменяло файлы без запроса прав администратора (UAC).
    -->
    <SetProperty Id="GrantAppDirWrite" Sequence="execute" Before="GrantAppDirWrite"
                 Value="&quot;[System64Folder]icacls.exe&quot; &quot;[APPDIR].&quot; /grant *S-1-5-32-545:(OI)(CI)M /T /Q" />
    <CustomAction Id="GrantAppDirWrite" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="InstallRecorderSvc" Sequence="execute" Before="InstallRecorderSvc"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c &quot;&quot;[RECORDERDIR]install-service.cmd&quot;&quot;" />
    <CustomAction Id="InstallRecorderSvc" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="RemoveRecorderSvc" Sequence="execute" Before="RemoveRecorderSvc"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c &quot;sc stop AbizRecorder &amp; ping -n 4 127.0.0.1 &gt;nul &amp; taskkill /F /IM AbizRecorder.exe &amp; sc delete AbizRecorder&quot;" />
    <CustomAction Id="RemoveRecorderSvc" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveRecorderSvc" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="InstallRecorderSvc" After="CreateAbizTask" Condition="NOT REMOVE" />
      <Custom Action="GrantAppDirWrite" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RemoveOldRunKeys" After="GrantAppDirWrite" Condition="NOT REMOVE" />
      <Custom Action="CreateAbizTask" After="RemoveOldRunKeys" Condition="NOT REMOVE" />
      <Custom Action="DeleteAbizTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Icon Id="AbizIcon" SourceFile="..\bundle\abiz.ico" />

    <!-- Папку установки выбрать нельзя: путь C:\Program Files\AnodBiz\AbizShell
         прописан в задаче автозапуска (AbizShell-task.xml). -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
