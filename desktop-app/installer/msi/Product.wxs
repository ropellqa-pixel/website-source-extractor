<?xml version="1.0" encoding="UTF-8"?>
<!-- MSI-пакет АБИЗ. Сборка: dotnet build installer\msi\AbizInstaller.wixproj -c Release -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="АБИЗ" Manufacturer="ООО «Рассвет»" Version="1.0.0.0"
           UpgradeCode="8a2e1c6a-5b3e-4d2a-9c7a-1f6e3b2d4a10"
           InstallerVersion="500" Compressed="yes" Scope="perMachine"
           Language="1049" Codepage="1251">

    <!-- Запрещаем установку поверх более новой версии и чисто обновляем старую. -->
    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия АБИЗ." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Иконка в «Программы и компоненты» -->
    <Property Id="ARPPRODUCTICON" Value="AbizIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Feature Id="MainFeature" Title="АБИЗ Shell" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AutoStartRegistryEntry" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AnodBiz">
        <Directory Id="APPDIR" Name="AbizShell" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="АБИЗ" />
    </StandardDirectory>

    <!-- Все файлы программы из папки publish. PublishDir передаётся из .wixproj. -->
    <ComponentGroup Id="AppFiles" Directory="APPDIR">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!--
      Автозапуск от имени системы (HKLM, а не HKCU) — обычный пользователь не может
      удалить этот ключ без прав администратора. Программа дополнительно прописывает
      себя и в HKCU при каждом старте (App.xaml.cs) — это резервный путь.
    -->
    <Component Id="AutoStartRegistryEntry" Directory="APPDIR" Guid="6e2a7d1c-4f8b-4a9e-8c3d-1a9f6e2b7c44">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                     Name="AbizShell"
                     Value="&quot;[APPDIR]AbizShell.exe&quot;"
                     Type="string" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="9c4f2b8e-1d6a-4e3f-b7c2-5a8d3e1f9b62">
      <Shortcut Id="AbizStartMenuShortcut"
                Name="АБИЗ"
                Description="Рабочая оболочка АБИЗ"
                Target="[APPDIR]AbizShell.exe"
                WorkingDirectory="APPDIR" />
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\AnodBiz\AbizShell" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Icon Id="AbizIcon" SourceFile="$(var.PublishDir)\AbizShell.exe" />

    <!-- Готовый интерфейс установщика: приветствие, выбор папки, прогресс, финал. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="APPDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>