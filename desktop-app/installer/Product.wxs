<?xml version="1.0" encoding="UTF-8"?>
<!--
  Установщик WiX Toolset v4 для АБИЗ. Собирается отдельно от AbizShell.csproj командой:
    dotnet build installer -c Release
  (требует установленного расширения "WiX Toolset" в Visual Studio 2026 или wix.exe из NuGet).

  Что делает инсталлятор:
  1. Копирует собранные файлы AbizShell (из bin\Release\net8.0-windows\win-x64\publish)
     в Program Files\AnodBiz\AbizShell.
  2. Прописывает автозапуск в HKEY_LOCAL_MACHINE (а не HKCU) — такой ключ реестра
     нельзя удалить без прав администратора, в отличие от резервного HKCU-автозапуска,
     который программа также ставит сама при каждом старте (см. App.xaml.cs).
  3. Создаёт ярлык в автозагрузке всех пользователей.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="АБИЗ" Manufacturer="ООО «Рассвет»" Version="1.0.0.0"
           UpgradeCode="8a2e1c6a-5b3e-4d2a-9c7a-1f6e3b2d4a10"
           InstallerVersion="500" Compressed="yes" Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия АБИЗ." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="АБИЗ Shell" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AutoStartRegistryEntry" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AnodBiz">
        <Directory Id="APPDIR" Name="AbizShell" />
      </Directory>
    </StandardDirectory>

    <!-- Файлы программы: подставляются при сборке из опубликованной папки. -->
    <ComponentGroup Id="AppFiles" Directory="APPDIR">
      <Component Id="MainExe" Guid="3b1d9f4a-7c2e-4a1b-9d6f-2e8a4c5b6d71">
        <File Id="AbizShellExe" Source="..\AbizShell\bin\Release\net8.0-windows\win-x64\publish\AbizShell.exe" KeyPath="yes" />
      </Component>
      <!-- Остальные .dll/.json из publish добавляются автоматически через Heat (harvest)
           либо перечисляются вручную при финальной сборке — см. README.md в этой папке. -->
    </ComponentGroup>

    <!-- Автозапуск от имени системы (HKLM) — переживает смену пользователя и обычный
         пользователь не может его отключить без прав администратора. -->
    <Component Id="AutoStartRegistryEntry" Directory="APPDIR" Guid="6e2a7d1c-4f8b-4a9e-8c3d-1a9f6e2b7c44">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                     Name="AbizShell"
                     Value="&quot;[APPDIR]AbizShell.exe&quot;"
                     Type="string" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
