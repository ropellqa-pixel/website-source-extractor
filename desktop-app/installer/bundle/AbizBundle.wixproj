<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>AbizSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>$(MSBuildThisFileDirectory)..\out\</OutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\AbizShell\bin\Release\net8.0-windows\win-x64\publish</PublishDir>
    <MsiPath>$(MSBuildThisFileDirectory)..\out\AbizSetup.msi</MsiPath>
    <RedistDir>$(MSBuildThisFileDirectory)..\redist</RedistDir>
    <DefineConstants>PublishDir=$(PublishDir);MsiPath=$(MsiPath);RedistDir=$(RedistDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.NetFx.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
