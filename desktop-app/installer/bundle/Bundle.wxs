<?xml version="1.0" encoding="UTF-8"?>
<!-- Итоговый AbizSetup.exe: .NET 8 + WebView2 + MSI. Сборка: dotnet build installer\bundle\AbizBundle.wixproj -c Release -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <Bundle Name="АБИЗ" Manufacturer="ООО «Рассвет»" Version="1.0.0.0"
          UpgradeCode="c1f4e2a7-9b3d-4c8e-a6f1-7d2b5e8c3a94"
          IconSourceFile="abiz.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseFile="License.rtf"
          Theme="rtfLicense"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <!-- Есть ли на ПК .NET 8 Desktop Runtime (x64). Результат — номер версии или пусто. -->
    <netfx:DotNetCoreSearch Id="DotNetDesktop8Search"
                            RuntimeType="desktop"
                            Platform="x64"
                            MajorVersion="8"
                            Variable="DotNetDesktop8Version" />

    <!-- Есть ли на ПК WebView2 Runtime. -->
    <util:RegistrySearch Id="WebView2MachineSearch"
                         Root="HKLM"
                         Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                         Value="pv"
                         Result="value"
                         Bitness="always32"
                         Variable="WebView2Version" />

    <Chain>
      <ExePackage Id="DotNetDesktopRuntime"
                  DisplayName="Microsoft .NET 8 Desktop Runtime"
                  SourceFile="$(var.RedistDir)\windowsdesktop-runtime-8.0-win-x64.exe"
                  InstallArguments="/install /quiet /norestart"
                  DetectCondition="DotNetDesktop8Version &gt;= v8.0.0"
                  Permanent="yes"
                  Vital="yes" />

      <ExePackage Id="WebView2Runtime"
                  DisplayName="Microsoft Edge WebView2 Runtime"
                  SourceFile="$(var.RedistDir)\MicrosoftEdgeWebview2Setup.exe"
                  InstallArguments="/silent /install"
                  DetectCondition="WebView2Version AND WebView2Version &lt;&gt; &quot;0.0.0.0&quot;"
                  Permanent="yes"
                  Vital="yes" />

      <MsiPackage Id="AbizShellMsi"
                  SourceFile="$(var.MsiPath)"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
