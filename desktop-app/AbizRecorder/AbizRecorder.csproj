<Project Sdk="Microsoft.NET.Sdk.Worker">
	<!-- Служба Windows «АБИЗ — видеорегистратор склада» (AbizRecorder).
	     Работает всегда, даже когда в АБИЗ никто не вошёл: пишет камеры склада и отправляет отрывки на сайт.
	     Код записи общий с программой АБИЗ (SkudRecorder.cs). -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyName>AbizRecorder</AssemblyName>
		<AssemblyTitle>ABIZ Recorder</AssemblyTitle>
		<Product>ABIZ Recorder</Product>
		<Company>Rassvet</Company>
		<Version>1.4.0</Version>
		<ApplicationIcon>..\AbizShell\abiz.ico</ApplicationIcon>
		<UserSecretsId></UserSecretsId>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\AbizShell\SkudRecorder.cs" Link="SkudRecorder.cs" />
		<Compile Include="..\AbizShell\GateBridge.cs" Link="GateBridge.cs" />
	</ItemGroup>
	<ItemGroup>
		<None Include="install-service.cmd;uninstall-service.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
	</ItemGroup>
</Project>
