<Window x:Class="AbizShell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="АБИЗ" WindowStyle="None" ResizeMode="NoResize"
        Topmost="False" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">

    <!--
      Главное окно оболочки. ВАЖНО:
      1) Окно НЕ "поверх всех" — иначе Word, Excel, MAX и другие программы открывались
         под ним и их не было видно. Поверх всех только верхняя панель (TopBarWindow).
      2) Браузер — WebView2CompositionControl. Обычный WebView2 рисуется отдельным окном
         поверх всего WPF, поэтому меню кнопок, календарь и редактор открывались «за сайтом».
    -->

    <Window.Resources>
        <Style x:Key="QA" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="999">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Padding="12,6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OvlBtn" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppTile" TargetType="Button">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Height" Value="148"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="24">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="24" BorderThickness="1" BorderBrush="#33FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                        <GradientStop Color="#14000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <wv2:WebView2CompositionControl x:Name="MainBrowser"/>

        <!-- Календарь и заметки -->
        <Border x:Name="SidePanel" Width="312" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Margin="0,10,12,12" Style="{DynamicResource CardBorder}" Padding="0" Visibility="Collapsed">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE711;" Width="30" Height="30" FontSize="11"
                            Click="CloseSidePanel_Click" ToolTip="Закрыть"/>
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentLightBrush}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE787;" Style="{DynamicResource IconText}" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="Календарь и заметки" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="4" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Calendar x:Name="SideCalendar" FirstDayOfWeek="Monday" SelectionMode="SingleDate"
                                  BorderThickness="0" Background="Transparent"
                                  SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                    </Viewbox>
                </Border>
                <TextBlock Grid.Row="2" x:Name="SelectedDateLabel" Text="Сегодня" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,6"/>
                <TextBox Grid.Row="3" x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" Padding="10,8"
                         FontSize="13" MinHeight="60" TextChanged="NotesBox_TextChanged"
                         VerticalScrollBarVisibility="Auto" ToolTip="Заметки сохраняются автоматически"/>
                <WrapPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Style="{StaticResource QA}" Content="Табель" Click="QuickAction_Click" Tag="schedule"/>
                    <Button Style="{StaticResource QA}" Content="Зарплата" Click="QuickAction_Click" Tag="salary"/>
                    <Button Style="{StaticResource QA}" Content="Касса" Click="QuickAction_Click" Tag="collection"/>
                    <Button Style="{StaticResource QA}" Content="Документы" Click="QuickAction_Click" Tag="documents"/>
                    <Button Style="{StaticResource QA}" Content="Чат" Click="QuickAction_Click" Tag="chat"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Меню кнопок (Launchpad). Открывается кнопкой «Меню», Tab или 2× Пробел. -->
        <Grid x:Name="OverlayGrid" Visibility="Collapsed">
            <Rectangle Fill="#F0F3F3F6" MouseLeftButtonDown="OverlayBackground_MouseDown"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="40,40,40,70">
                <WrapPanel x:Name="TilesPanel" HorizontalAlignment="Center" MaxWidth="1100"/>
            </ScrollViewer>
            <Border Style="{DynamicResource ChipBorder}" Background="{DynamicResource CardBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="14,6" IsHitTestVisible="False">
                <TextBlock Text="Esc или клик по пустому месту — закрыть" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
            </Border>
        </Grid>

        <!-- Редактор кнопок (только админ) -->
        <Grid x:Name="EditorOverlay" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource ScrimBrush}"/>
            <Border Width="980" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{DynamicResource CardBorder}" CornerRadius="20" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="12"
                                Click="CloseEditor_Click" ToolTip="Закрыть"/>
                        <TextBlock Text="Кнопки меню" FontSize="20" FontWeight="SemiBold" FontFamily="{DynamicResource DisplayFont}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Название · Сайт или программа · Цвет · Тип (Сайт / Программа). Для программы нажмите «Обзор» и выберите .exe-файл. Изменения сохраняются для всех компьютеров."/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EditorRowsPanel"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{DynamicResource SecondaryButton}" Content="+ Добавить кнопку" Margin="0,0,8,0" Click="AddButton_Click"/>
                        <Button Style="{DynamicResource PrimaryButton}" Content="Сохранить" Click="SaveButtons_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Уведомление -->
        <Border x:Name="NotificationPanel" Width="340" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,18,18" Style="{DynamicResource CardBorder}" CornerRadius="14" Padding="14" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{DynamicResource Accent2Brush}" Margin="0,0,12,0"/>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="10"
                                Click="CloseNotification_Click" Width="24" Height="24"/>
                        <TextBlock x:Name="NotificationIcon" Text="&#x1F4AC;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="NotificationTitle" Text="Уведомление" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock x:Name="NotificationMessage" Text="" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" CornerRadius="999"
                Background="#E6FFFFFF" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="10,3">
            <TextBlock x:Name="DeviceCodeDisplay" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       Text="Код ПК: ---"
                       MouseLeftButtonDown="DeviceCode_MouseLeftButtonDown"
                       Cursor="Hand" ToolTip="Три быстрых клика — получить новый код"/>
        </Border>

        <!-- Нет сети -->
        <Grid x:Name="ShellNetworkOverlay" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource ScrimBrush}"/>
            <Border Style="{DynamicResource CardBorder}" CornerRadius="22" Padding="40,34"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="540">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource DangerLightBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#xEB55;" Style="{DynamicResource IconText}" FontSize="28" Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                    <TextBlock Text="Сеть недоступна" FontSize="26" FontWeight="SemiBold" FontFamily="{DynamicResource DisplayFont}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Нет связи с сервером. Программы на компьютере (Word, Excel, проводник) работают — откройте их через «Меню» или «Окна»."
                               FontSize="14" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Проверить снова" Margin="0,0,10,0"
                                Click="ShellRetryNetwork_Click" Style="{StaticResource OvlBtn}"/>
                        <Button Content="Скрыть" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Click="HideNetworkOverlay_Click" Style="{StaticResource OvlBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
