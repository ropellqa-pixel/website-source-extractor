<Window x:Class="AbizShell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="АБИЗ" WindowStyle="None" ResizeMode="NoResize"
        Topmost="False" Background="#1E1E2E" ShowInTaskbar="False">

    <!--
      Главное окно оболочки. ВАЖНО:
      1) Окно НЕ "поверх всех" — иначе Word, Excel, MAX и другие программы открывались
         под ним и их не было видно. Поверх всех только верхняя панель (TopBarWindow).
      2) Браузер — WebView2CompositionControl. Обычный WebView2 рисуется отдельным окном
         поверх всего WPF, поэтому меню кнопок, календарь и редактор открывались «за сайтом».
    -->

    <Window.Resources>
        <Style x:Key="QA" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#22FFFFFF" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12"
                                       Foreground="#CCFFFFFF" Padding="8,5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OvlBtn" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppTile" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="28"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <wv2:WebView2CompositionControl x:Name="MainBrowser"/>

        <!-- Календарь и заметки -->
        <Border x:Name="SidePanel" Width="290" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Margin="0,8,8,8" Background="#F21A1A2E" CornerRadius="16" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="&#x2715;" Width="26" Height="26" Background="Transparent"
                            Foreground="#AAFFFFFF" BorderThickness="0" Cursor="Hand" Click="CloseSidePanel_Click"/>
                    <TextBlock Text="Календарь и заметки" FontSize="15" FontWeight="Bold" Foreground="White"/>
                </DockPanel>
                <Calendar Grid.Row="1" x:Name="SideCalendar" FirstDayOfWeek="Monday" SelectionMode="SingleDate"
                          SelectedDatesChanged="Calendar_SelectedDatesChanged" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" x:Name="SelectedDateLabel" Text="Сегодня" FontSize="12" Foreground="#88FFFFFF" Margin="0,0,0,6"/>
                <Border Grid.Row="3" Background="#0D0D14" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="8"
                             FontSize="13" MinHeight="60" TextChanged="NotesBox_TextChanged"
                             VerticalScrollBarVisibility="Auto" ToolTip="Заметки сохраняются автоматически"/>
                </Border>
                <WrapPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Style="{StaticResource QA}" Content="Табель" Click="QuickAction_Click" Tag="schedule"/>
                    <Button Style="{StaticResource QA}" Content="Зарплата" Click="QuickAction_Click" Tag="salary"/>
                    <Button Style="{StaticResource QA}" Content="Касса" Click="QuickAction_Click" Tag="collection"/>
                    <Button Style="{StaticResource QA}" Content="Документы" Click="QuickAction_Click" Tag="documents"/>
                    <Button Style="{StaticResource QA}" Content="Чат" Click="QuickAction_Click" Tag="chat"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Меню кнопок (Launchpad). Открывается кнопкой «Меню», Tab или 2× Пробел. -->
        <Grid x:Name="OverlayGrid" Visibility="Collapsed">
            <Rectangle Fill="#E60A0A14" MouseLeftButtonDown="OverlayBackground_MouseDown"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="40,40,40,70">
                <WrapPanel x:Name="TilesPanel" HorizontalAlignment="Center" MaxWidth="1100"/>
            </ScrollViewer>
            <TextBlock Text="Esc или клик по пустому месту — закрыть" Foreground="#77FFFFFF"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"/>
        </Grid>

        <!-- Редактор кнопок (только админ) -->
        <Grid x:Name="EditorOverlay" Visibility="Collapsed">
            <Rectangle Fill="#F00A0A14"/>
            <Border Width="900" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1A1A2E" CornerRadius="20" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="&#x2715;" Width="28" Height="28" Background="Transparent"
                                Foreground="#AAFFFFFF" BorderThickness="0" Click="CloseEditor_Click" ToolTip="Закрыть"/>
                        <TextBlock Text="Кнопки меню" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Foreground="#88FFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Название · Сайт или программа · Цвет · Тип (Сайт / Программа). Для программы нажмите «Обзор» и выберите .exe-файл. Изменения сохраняются для всех компьютеров."/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EditorRowsPanel"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="+ Добавить кнопку" FontSize="13" Padding="14,8" Margin="0,0,8,0"
                                Background="#333344" Foreground="White" BorderThickness="0" Cursor="Hand" Click="AddButton_Click"/>
                        <Button Content="Сохранить" FontSize="13" Padding="14,8"
                                Background="#4A90D9" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SaveButtons_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Уведомление -->
        <Border x:Name="NotificationPanel" Width="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" Background="#EE1A1A2E" CornerRadius="10" Visibility="Collapsed" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="&#x2715;" FontSize="11" Foreground="#88FFFFFF"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="CloseNotification_Click" Width="22" Height="22"/>
                    <TextBlock x:Name="NotificationIcon" Text="&#x1F4AC;" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="NotificationTitle" Text="Уведомление" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="NotificationMessage" Text="" FontSize="12" Foreground="#BBFFFFFF" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="DeviceCodeDisplay" Foreground="#44FFFFFF" FontSize="11" Background="#661A1A2E" Padding="6,2"
                   Text="Код ПК: ---" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,6"
                   MouseLeftButtonDown="DeviceCode_MouseLeftButtonDown"
                   Cursor="Hand" ToolTip="Три быстрых клика — получить новый код"/>

        <!-- Нет сети -->
        <Grid x:Name="ShellNetworkOverlay" Visibility="Collapsed">
            <Rectangle Fill="#EE0A0A14"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <TextBlock Text="&#x26A0;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Сеть недоступна" FontSize="28" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Нет связи с сервером. Программы на компьютере (Word, Excel, проводник) работают — откройте их через «Меню» или «Окна»."
                           FontSize="15" Foreground="#AAFFFFFF" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Проверить снова" Background="#4A6FA5" Margin="0,0,12,0"
                            Click="ShellRetryNetwork_Click" Style="{StaticResource OvlBtn}"/>
                    <Button Content="Скрыть" Background="#444458"
                            Click="HideNetworkOverlay_Click" Style="{StaticResource OvlBtn}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>