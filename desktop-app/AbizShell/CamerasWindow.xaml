<Window x:Class="AbizShell.CamerasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АБИЗ — Камеры" Background="#0D0D14"
        WindowStartupLocation="CenterScreen">
    <!--
      Раздел «Камеры» внутри АБИЗ. Все камеры компании показываются живым видео через
      встроенный бесплатный декодер VLC (H.265 без платного расширения Microsoft Store).
      Сетка плиток; клик по плитке разворачивает одну камеру на весь экран.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#15151F" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Камеры" Foreground="White" FontSize="22" FontWeight="Bold"
                       Margin="20,14" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" x:Name="CloseButton" Click="Close_Click" Margin="14,10"
                    Content="Закрыть" Foreground="White" FontSize="15" Cursor="Hand" Padding="18,8">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#2A2A3C" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A3A50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button DockPanel.Dock="Right" x:Name="RefreshButton" Click="Refresh_Click" Margin="0,10"
                    Content="Обновить" Foreground="White" FontSize="15" Cursor="Hand" Padding="18,8">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#2A2A3C" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A3A50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl x:Name="TilesHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid x:Name="TilesPanel" Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="StatusLabel" Text="Загрузка камер..." Foreground="#AAFFFFFF" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="560"/>
        </Grid>
    </Grid>
</Window>
