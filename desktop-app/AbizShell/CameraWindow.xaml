<Window x:Class="AbizShell.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="АБИЗ — Камера Зал"
        Background="Black" WindowStartupLocation="CenterScreen">

    <!--
      Окно «Камера Зал»: только прямая трансляция камеры «Зал-Касса», без архива и настроек.
      Видео показывает страница сайта /cam-view со своим декодером H.265 (тот же, что в разделе «Камеры»).
      Внизу — длинная кнопка «ВХОД — Авторизация», она возвращает на экран ввода пароля.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Black">
            <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="Black"/>
            <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#B3000000" CornerRadius="16" Padding="24,14" MaxWidth="560" IsHitTestVisible="False">
                <TextBlock x:Name="StatusLabel" Text="Подключение к камере..." Foreground="White"
                           FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </Grid>

        <Button Grid.Row="1" x:Name="LoginButton" Click="Login_Click" Height="76" Cursor="Hand"
                Foreground="White" FontSize="24" FontWeight="Bold">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="#4A90D9">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F511;" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ВХОД — Авторизация" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#5AA0E9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3A7FC8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
