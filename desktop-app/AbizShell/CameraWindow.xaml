<Window x:Class="AbizShell.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="АБИЗ — Камера Зал"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!--
      Окно «Камера Зал»: только прямая трансляция камеры «Зал-Касса», без архива и настроек.
      Видео показывает страница сайта /cam-view со своим декодером H.265 (тот же, что в разделе «Камеры»).
      Внизу — длинная кнопка «ВХОД — Авторизация», она возвращает на экран ввода пароля.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,14">
            <Border DockPanel.Dock="Right" Style="{DynamicResource ChipBorder}" Background="{DynamicResource DangerLightBrush}"
                    BorderBrush="{DynamicResource DangerLightHoverBrush}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Прямой эфир" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentLightBrush}">
                    <TextBlock Text="&#xE714;" Style="{DynamicResource IconText}" FontSize="17" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Камера «Зал»" FontSize="18" FontWeight="SemiBold" FontFamily="{DynamicResource DisplayFont}"/>
                    <TextBlock Text="Трансляция без входа в систему" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="16" Background="{DynamicResource VideoBrush}" Effect="{DynamicResource CardShadow}"/>
        <Border Grid.Row="1" CornerRadius="16" Background="{DynamicResource VideoBrush}" Padding="6">
            <Grid Background="{DynamicResource VideoBrush}">
                <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="Black"/>
                <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F2FFFFFF" CornerRadius="14" Padding="22,12" MaxWidth="560" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFont}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusLabel" Text="Подключение к камере..." Foreground="{DynamicResource TextBrush}"
                                   FontSize="16" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" MaxWidth="480"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Button Grid.Row="2" x:Name="LoginButton" Style="{DynamicResource PrimaryButton}" Click="Login_Click"
                Height="64" Margin="0,16,0,0" FontSize="20" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D7;" Style="{DynamicResource IconText}" FontSize="20" Margin="0,0,12,0"/>
                <TextBlock Text="ВХОД — Авторизация" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
