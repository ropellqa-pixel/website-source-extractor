<Window x:Class="AbizShell.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="АБИЗ — Камера Зал"
        Background="Black" WindowStartupLocation="CenterScreen">

    <!--
      Окно «Камера Зал»: только прямая трансляция камеры «Зал-Касса», без архива и настроек.
      Видео показывает встроенный бесплатный декодер VLC (H.265 работает без платных кодеков Windows).
      Внизу — длинная кнопка «ВХОД — Авторизация», она возвращает на экран ввода пароля.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Black">
            <vlc:VideoView x:Name="Video">
                <!-- Поверх VideoView WPF-элементы кладутся только внутрь него -->
                <Grid>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18" Padding="12,6"
                            Background="#99000000" CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CameraNameLabel" Text="Камера Зал" Foreground="White" FontSize="20"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Background="#D32F2F" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ClockLabel" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="18"
                               Foreground="#DDFFFFFF" FontSize="20" FontWeight="SemiBold" Text="00:00"/>

                    <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#B3000000" CornerRadius="16" Padding="24,14" MaxWidth="560">
                        <TextBlock x:Name="StatusLabel" Text="Подключение к камере..." Foreground="White"
                                   FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Grid>

        <Button Grid.Row="1" x:Name="LoginButton" Click="Login_Click" Height="76" Cursor="Hand"
                Foreground="White" FontSize="24" FontWeight="Bold">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="#4A90D9">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F511;" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ВХОД — Авторизация" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#5AA0E9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3A7FC8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
