<UserControl x:Class="AbizShell.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="6" CornerRadius="12" Background="Black" ClipToBounds="True" Cursor="Hand"
            MouseLeftButtonUp="Tile_Click">
        <Grid>
            <Image x:Name="Video" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
            <Grid IsHitTestVisible="False">
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Padding="9,4"
                        Background="#99000000" CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameLabel" Text="Камера" Foreground="White" FontSize="14"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#D32F2F" CornerRadius="7" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#B3000000" CornerRadius="10" Padding="16,8">
                    <TextBlock x:Name="StatusLabel" Text="Подключение..." Foreground="White" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
