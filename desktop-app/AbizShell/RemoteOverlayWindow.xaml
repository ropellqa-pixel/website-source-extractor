<Window x:Class="AbizShell.RemoteOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АБИЗ" WindowStyle="None" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False" Background="#F20D0D14"
        WindowStartupLocation="CenterScreen">
    <!--
      Полноэкранное окно поверх всего. Два режима:
      — "message": сообщение от зам. директора, сотрудник читает и закрывает кнопкой «Понятно».
      — "lock": блокировка ПК замом, закрыть нельзя, снимается только командой «Разблокировать».
    -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="820" Margin="40">
            <TextBlock x:Name="IconLabel" Text="&#x1F4AC;" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="TitleLabel" Text="Сообщение от руководства" FontSize="34" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>
            <Border Background="#1A1A2E" CornerRadius="18" Padding="30,24" MaxWidth="760">
                <TextBlock x:Name="MessageLabel" Text="" FontSize="22" Foreground="#EEFFFFFF"
                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="32"/>
            </Border>
            <Button x:Name="CloseButton" Content="Понятно" FontSize="20" FontWeight="Bold" Foreground="White"
                    Cursor="Hand" Padding="40,14" Margin="0,30,0,0" HorizontalAlignment="Center" Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#4A90D9" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#5AA0E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="LockHint" Text="Компьютер заблокирован. Обратитесь к заместителю директора."
                       FontSize="15" Foreground="#88FFFFFF" HorizontalAlignment="Center" Margin="0,24,0,0"
                       Visibility="Collapsed" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
