<Window x:Class="AbizShell.RemoteOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АБИЗ" WindowStyle="None"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!--
      Полноэкранное окно поверх всего. Два режима:
      — "message": сообщение от зам. директора, сотрудник читает и закрывает кнопкой «Понятно».
      — "lock": блокировка ПК замом, закрыть нельзя, снимается только командой «Разблокировать».
    -->
    <Grid Background="{DynamicResource FrostBgBrush}">
        <Ellipse Width="640" Height="640" Margin="-220,-260,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E0891B2" Offset="0"/>
                    <GradientStop Color="#000891B2" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="560" Height="560" Margin="0,0,-200,-220" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#240E7490" Offset="0"/>
                    <GradientStop Color="#000E7490" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border Style="{DynamicResource CardBorder}" CornerRadius="24" Padding="48,40"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="820" Margin="40">
            <StackPanel>
                <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource AccentLightBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,22">
                    <TextBlock x:Name="IconLabel" Text="&#xE8BD;" FontFamily="{DynamicResource IconFont}" FontSize="38"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleLabel" Text="Сообщение от руководства" FontSize="30" FontWeight="SemiBold"
                           FontFamily="{DynamicResource DisplayFont}"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="30,24" MaxWidth="720">
                    <TextBlock x:Name="MessageLabel" Text="" FontSize="22" Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="32"/>
                </Border>
                <Button x:Name="CloseButton" Style="{DynamicResource PrimaryButton}" Content="Понятно" FontSize="18"
                        Padding="48,14" Margin="0,28,0,0" HorizontalAlignment="Center" Click="Close_Click"/>
                <Border x:Name="LockHint" Visibility="Collapsed" Background="{DynamicResource WarningLightBrush}"
                        CornerRadius="12" Padding="16,10" Margin="0,24,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="15"
                                   Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Компьютер заблокирован. Обратитесь к заместителю директора."
                                   FontSize="14" Foreground="#92400E" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
