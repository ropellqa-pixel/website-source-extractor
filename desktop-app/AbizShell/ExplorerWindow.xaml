<Window x:Class="AbizShell.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АБИЗ — Проводник" Width="1100" Height="700" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ExBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconExBtn" TargetType="Button" BasedOn="{StaticResource ExBtn}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PlaceBtn" TargetType="Button" BasedOn="{StaticResource ExBtn}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ExBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Навигация и действия -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource IconExBtn}" Content="&#xE72B;" Click="Back_Click" ToolTip="Назад"/>
                <Button Style="{StaticResource IconExBtn}" Content="&#xE74A;" Click="Up_Click" ToolTip="На уровень выше"/>
                <Button Style="{StaticResource IconExBtn}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="Обновить"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button x:Name="OpenBtn" Style="{StaticResource ExBtn}" Content="Открыть" Click="Open_Click"/>
                <Button x:Name="PrintBtn" Style="{StaticResource AccentBtn}" Click="Print_Click" ToolTip="Напечатать выбранные файлы">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Печать" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ExBtn}" Click="NewFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Новая папка" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RenameBtn" Style="{StaticResource ExBtn}" Content="Переименовать" Click="Rename_Click"/>
                <Button x:Name="DeleteBtn" Style="{StaticResource ExBtn}" Content="Удалить" Click="Delete_Click"
                        Foreground="{DynamicResource DangerBrush}" Margin="0"/>
            </StackPanel>
            <TextBox x:Name="PathBox" FontSize="13" Padding="10,0" Height="36" Margin="6,0,0,0"
                     KeyDown="PathBox_KeyDown" ToolTip="Путь к папке — можно ввести и нажать Enter"/>
        </DockPanel>

        <!-- Быстрый доступ и диски -->
        <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource CardBorder}" CornerRadius="14" Margin="0,0,12,0" Padding="8"
                Effect="{DynamicResource SoftShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PlacesPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Файлы -->
        <Border Grid.Row="1" Grid.Column="1" Style="{DynamicResource CardBorder}" CornerRadius="14" Padding="6"
                Effect="{DynamicResource SoftShadow}">
            <ListView x:Name="FilesList" SelectionMode="Extended"
                      Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontSize="13"
                      MouseDoubleClick="FilesList_MouseDoubleClick" KeyDown="FilesList_KeyDown"
                      SelectionChanged="FilesList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Padding" Value="4,7"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                              Content="{TemplateBinding Content}"
                                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource ExHeader}">
                        <GridViewColumn Header="Имя" Width="440">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Изменён" Width="150" DisplayMemberBinding="{Binding Modified}"/>
                        <GridViewColumn Header="Тип" Width="110" DisplayMemberBinding="{Binding Kind}"/>
                        <GridViewColumn Header="Размер" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="Двойной клик — открыть. Выделите файлы и нажмите «Печать». Ctrl или Shift — выбрать несколько."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
