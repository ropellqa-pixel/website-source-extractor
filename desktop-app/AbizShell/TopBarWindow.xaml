<Window x:Class="AbizShell.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АБИЗ — панель" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource CardBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Height="60" Left="0" Top="0">

    <Window.Resources>
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBarBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#45454A"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="40"/>
        </Style>

        <Style x:Key="LabeledBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
        </Style>

        <Style x:Key="WindowRowBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuPillBtn" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource PrimaryBrush}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShutdownBtn" TargetType="Button" BasedOn="{StaticResource LabeledBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource DangerLightBrush}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerLightHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="14,4,14,20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Fill" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource CardBrush}"/>

        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Слева: статус сети, название, навигация браузера, меню кнопок, окна -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="34" Height="34" Margin="0,0,10,0">
                    <Border CornerRadius="10" Background="{DynamicResource PrimaryBrush}">
                        <Grid>
                            <TextBlock Text="А" FontSize="17" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            <Border Height="3" Width="16" CornerRadius="1.5" Background="{DynamicResource Accent2Brush}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        </Grid>
                    </Border>
                    <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#16A34A" Stroke="White" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" ToolTip="Сеть: подключено"/>
                </Grid>
                <TextBlock Text="АБИЗ" FontSize="17" FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                <Button Style="{StaticResource MenuPillBtn}" Click="Menu_Click" ToolTip="Меню программ и сайтов (Tab или 2× Пробел)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0E2;" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Меню" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="WindowsBtn" Style="{StaticResource LabeledBtn}" Margin="6,0,2,0" Click="Windows_Click" ToolTip="Открытые программы — переключиться или закрыть">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C4;" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="WindowsBtnText" Text="Окна" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource BarDivider}"/>

                <Button Style="{StaticResource IconBarBtn}" Content="&#xE80F;" Click="Home_Click" ToolTip="Главная страница"/>
                <Button Style="{StaticResource IconBarBtn}" Content="&#xE72B;" Click="Back_Click" ToolTip="Назад"/>
                <Button Style="{StaticResource IconBarBtn}" Content="&#xE72A;" Click="Forward_Click" ToolTip="Вперёд"/>
                <Button Style="{StaticResource IconBarBtn}" Content="&#xE72C;" Click="Reload_Click" ToolTip="Обновить страницу"/>
            </StackPanel>

            <!-- По центру: часы -->
            <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="999" Padding="16,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ClockLabel" Text="00:00" FontSize="20" FontWeight="SemiBold" FontFamily="{DynamicResource DisplayFont}"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource LineStrongBrush}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DateLabel" Text="1 янв" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Справа: инструменты и завершение работы (раньше часть была в нижней панели) -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="UserChip" Style="{DynamicResource ChipBorder}" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentLightBrush}" Margin="0,0,8,0" Padding="4,4,12,4" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="UserChipText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconBarBtn}" Content="&#xE8B7;" Click="Explorer_Click" ToolTip="Проводник — файлы, флешки, печать файлов"/>
                <Button Style="{StaticResource IconBarBtn}" Content="&#xE749;" Click="Print_Click" ToolTip="Печать текущей страницы"/>
                <Button x:Name="ExtensionsBtn" Style="{StaticResource IconBarBtn}" Content="&#xEA86;" Click="Extensions_Click" ToolTip="Расширения браузера (ЭЦП, Рутокен, СБИС)"/>
                <Button Style="{StaticResource IconBarBtn}" Content="&#xE714;" Click="Cameras_Click" ToolTip="Камеры — живое видео"/>
                <Button Style="{StaticResource IconBarBtn}" Content="&#xE787;" Click="Calendar_Click" ToolTip="Календарь и заметки"/>

                <Rectangle Style="{StaticResource BarDivider}"/>

                <Button x:Name="NetworkBtn" Style="{StaticResource IconBarBtn}" Click="Network_Click" ToolTip="Настройки сети: Wi‑Fi и подключение">
                    <TextBlock x:Name="NetworkBtnIcon" Text="&#xE701;" FontSize="16" FontFamily="{DynamicResource IconFont}"/>
                </Button>
                <Button x:Name="VolumeBtn" Style="{StaticResource IconBarBtn}" Click="Volume_Click" ToolTip="Громкость">
                    <TextBlock x:Name="VolumeBtnIcon" Text="&#xE995;" FontSize="16" FontFamily="{DynamicResource IconFont}"/>
                </Button>
                <Button x:Name="LangBtn" Style="{StaticResource LabeledBtn}" Content="RU" FontSize="12" Padding="10,0" Margin="4,0" Height="32"
                        Click="Lang_Click" ToolTip="Сменить раскладку клавиатуры"/>
                <Button x:Name="AdminBtn" Style="{StaticResource IconBarBtn}" Content="&#xE713;" Click="Admin_Click" Visibility="Collapsed" ToolTip="Меню администратора"/>
                <Button Style="{StaticResource IconBarBtn}" Content="&#xE72E;" Click="Lock_Click" ToolTip="Заблокировать экран"/>
                <Button Style="{StaticResource ShutdownBtn}" Margin="6,0,0,0" Click="Shutdown_Click" ToolTip="Выключить компьютер">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Завершить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Список открытых окон -->
            <Popup x:Name="WindowsPopup" PlacementTarget="{Binding ElementName=WindowsBtn}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4" HorizontalOffset="-14" PopupAnimation="Fade">
                <Border Style="{StaticResource PopupBox}" Width="440">
                    <StackPanel>
                        <TextBlock Text="Открытые программы" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,10"/>
                        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WindowsList"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Громкость -->
            <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeBtn}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4" HorizontalOffset="-154" PopupAnimation="Fade">
                <Border Style="{StaticResource PopupBox}" Width="340">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Style="{DynamicResource ChipBorder}" Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentLightBrush}" Padding="10,2">
                                <TextBlock x:Name="VolumeValueLabel" Text="50%" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="Громкость" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="MuteBtn" DockPanel.Dock="Left" Style="{StaticResource IconBarBtn}" Click="Mute_Click"
                                    Margin="0,0,10,0" Background="{DynamicResource SubtleBrush}" ToolTip="Выключить / включить звук">
                                <TextBlock x:Name="MuteBtnIcon" Text="&#xE995;" FontSize="16" FontFamily="{DynamicResource IconFont}"/>
                            </Button>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                        </DockPanel>
                        <UniformGrid Columns="5" Margin="0,12,0,0">
                            <Button Style="{StaticResource LabeledBtn}" Content="0%" Click="VolumePreset_Click" Tag="0" Height="32" FontSize="12" Padding="0"/>
                            <Button Style="{StaticResource LabeledBtn}" Content="25%" Click="VolumePreset_Click" Tag="25" Height="32" FontSize="12" Padding="0"/>
                            <Button Style="{StaticResource LabeledBtn}" Content="50%" Click="VolumePreset_Click" Tag="50" Height="32" FontSize="12" Padding="0"/>
                            <Button Style="{StaticResource LabeledBtn}" Content="75%" Click="VolumePreset_Click" Tag="75" Height="32" FontSize="12" Padding="0"/>
                            <Button Style="{StaticResource LabeledBtn}" Content="100%" Click="VolumePreset_Click" Tag="100" Height="32" FontSize="12" Padding="0"/>
                        </UniformGrid>
                        <TextBlock x:Name="VolumeHint" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Сеть -->
            <Popup x:Name="NetworkPopup" PlacementTarget="{Binding ElementName=NetworkBtn}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4" HorizontalOffset="-214" PopupAnimation="Fade">
                <Border Style="{StaticResource PopupBox}" Width="420">
                    <StackPanel>
                        <TextBlock Text="Сеть" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="NetStateDot" Width="10" Height="10" Fill="#16A34A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NetStateLabel" Text="Проверяю..." FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="NetAdaptersList" Margin="2,2,0,10"/>
                        <WrapPanel>
                            <Button Style="{StaticResource LabeledBtn}" Click="NetWifi_Click" Height="34" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE701;" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Wi‑Fi сети" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LabeledBtn}" Click="NetSettings_Click" Height="34" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Параметры сети" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LabeledBtn}" Click="NetCheck_Click" Height="34" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Проверить связь" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NetAdaptersBtn" Style="{StaticResource LabeledBtn}" Click="NetAdapters_Click" Height="34" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Сетевые адаптеры" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Расширения браузера -->
            <Popup x:Name="ExtensionsPopup" PlacementTarget="{Binding ElementName=ExtensionsBtn}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4" HorizontalOffset="-314" PopupAnimation="Fade">
                <Border Style="{StaticResource PopupBox}" Width="440">
                    <StackPanel>
                        <TextBlock Text="Расширения браузера" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Для работы с ЭЦП на компьютере должны быть установлены программы КриптоПро / Рутокен / СБИС Плагин."
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="ExtensionsList"/>
                        <Button Style="{StaticResource LabeledBtn}" Margin="0,8,0,0" Height="34" HorizontalAlignment="Left" Click="OpenInEdge_Click"
                                ToolTip="Если подпись не работает во встроенном браузере — откройте эту же страницу в Microsoft Edge">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Открыть страницу в Microsoft Edge" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>