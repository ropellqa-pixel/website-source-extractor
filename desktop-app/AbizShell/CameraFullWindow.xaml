<Window x:Class="AbizShell.CameraFullWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="АБИЗ — Камера" Background="Black"
        WindowStartupLocation="CenterOwner">
    <!-- Одна камера на весь экран со звуком. Закрытие возвращает в сетку камер. -->
    <Grid>
        <vlc:VideoView x:Name="Video"/>
        <Grid>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18" Padding="12,6"
                    Background="#99000000" CornerRadius="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NameLabel" Text="Камера" Foreground="White" FontSize="20"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#D32F2F" CornerRadius="9" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="18" Orientation="Horizontal">
                <Button x:Name="MuteButton" Click="Mute_Click" Content="&#x1F507;" FontSize="18" Cursor="Hand"
                        Foreground="White" Width="48" Height="48" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#99000000" CornerRadius="24">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#CC000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CloseButton" Click="Close_Click" Content="&#x2715;" FontSize="20" Cursor="Hand"
                        Foreground="White" Width="48" Height="48">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#99000000" CornerRadius="24">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#CCD32F2F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#B3000000" CornerRadius="14" Padding="22,12">
                <TextBlock x:Name="StatusLabel" Text="Подключение к камере..." Foreground="White" FontSize="16"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500"/>
            </Border>
        </Grid>
    </Grid>
</Window>
