<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<StartupObject>AbizShell.App</StartupObject>
		<ApplicationIcon>abiz.ico</ApplicationIcon>
		<EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
		<AssemblyName>AbizShell</AssemblyName>
		<AssemblyTitle>ABIZ</AssemblyTitle>
		<Product>ABIZ</Product>
		<Company>Rassvet</Company>
	</PropertyGroup>
	<ItemGroup>
		<ApplicationDefinition Remove="App.xaml" />
		<Page Remove="App.xaml" />
		<None Remove="App.xaml" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
	</ItemGroup>
</Project>