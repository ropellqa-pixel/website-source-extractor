<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Версия Windows в TargetFramework обязательна: новый браузер (WebView2CompositionControl)
		     использует библиотеку Microsoft.Windows.SDK.NET. Без неё вход падал с ошибкой
		     "Could not load file or assembly Microsoft.Windows.SDK.NET". -->
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<StartupObject>AbizShell.App</StartupObject>
		<ApplicationIcon>abiz.ico</ApplicationIcon>
		<EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
		<Company>Rassvet</Company>
		<Version>1.8.0</Version>
		<Configurations>Debug;Release;DebugAdmin;ReleaseAdmin</Configurations>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<!-- Две программы из одного кода:
	     Debug / Release            — АБИЗ (киоск: на весь экран, автозапуск, блокировка клавиш);
	     DebugAdmin / ReleaseAdmin  — АБИЗ-Админ (обычное окно, без автозапуска и без блокировок). -->
	<PropertyGroup Condition="'$(Configuration)' == 'DebugAdmin' Or '$(Configuration)' == 'ReleaseAdmin'">
		<AbizAdmin>true</AbizAdmin>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'ReleaseAdmin'">
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'DebugAdmin'">
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(AbizAdmin)' == 'true'">
		<DefineConstants>$(DefineConstants);ABIZ_ADMIN</DefineConstants>
		<AssemblyName>AbizAdmin</AssemblyName>
		<AssemblyTitle>ABIZ Admin</AssemblyTitle>
		<Product>ABIZ Admin</Product>
		<ApplicationManifest>app.admin.manifest</ApplicationManifest>
	</PropertyGroup>
	<PropertyGroup Condition="'$(AbizAdmin)' != 'true'">
		<AssemblyName>AbizShell</AssemblyName>
		<AssemblyTitle>ABIZ</AssemblyTitle>
		<Product>ABIZ</Product>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<ApplicationDefinition Remove="App.xaml" />
		<Page Remove="App.xaml" />
		<None Remove="App.xaml" />
	</ItemGroup>
	<ItemGroup>
		<!-- Встроенные расширения браузера (КриптоПро, Рутокен, СБИС) копируются рядом с программой. -->
		<None Include="Extensions\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
		<!-- Снимок экрана для удалённого контроля (GDI+, только Windows). -->
		<PackageReference Include="System.Drawing.Common" Version="8.0.8" />
		<!-- Шифрование сохранённых паролей сайтов (Windows DPAPI). -->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
	</ItemGroup>

</Project>